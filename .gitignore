# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# FMSG Agents build artifacts & local diagnostic logs
src/apps/fmsg-agents/node_modules/
src/apps/fmsg-agents/dist/
src/apps/fmsg-agents/renderer/bundle.js
src/apps/fmsg-agents/dist/electron/
src/apps/fmsg-agents/logs/
src/apps/fmsg-agents/.dev-diag-flag.json
src/apps/fmsg-agents/keys/

# recycle bin
/recycle_bin

# opencode local session/context/secrets (key lives here - keep out of git)
.opencode/

# vercel env files (contain live OIDC tokens)
.env.vercel
.env.production
.env.preview

# typescript
*.tsbuildinfo
next-env.d.ts

# Playwright
playwright-report/
test-results/
src/apps/fmsg-agents/tests/ui/shots/**/*.png
src/apps/fmsg-agents/tests/ui/baseline-v0.7.1/**/*.png
