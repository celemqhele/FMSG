{
  "name": "fmsg-agents",
  "version": "0.10.0",
  "author": "FMSG (Find Me Some Jobs)",
  "description": "FMSG Agents - desktop assistant for automated job applications",
  "main": "dist/electron-main.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "tsc -p tsconfig.main.json",
    "build:renderer": "esbuild renderer/index.tsx --bundle --minify --loader:.tsx=tsx --loader:.ts=ts --loader:.css=text --loader:.md=text --outfile=renderer/bundle.js --platform=browser --format=cjs",
    "build:code": "npm run build:main && npm run build:renderer",
    "build:all": "npm run build:main && npm run build:renderer && electron-builder",
    "ui:shots": "node tests/ui/shots.cjs",
    "ui:a11y": "node tests/ui/a11y.cjs",
    "ui:flows": "node tests/ui/flows.cjs",
    "test:main": "node tests/main/startup-slot-health.cjs",
    "lint:content": "node scripts/lint-content.cjs",
    "lint:tokens": "node scripts/lint-tokens.cjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "electron-updater": "^6.3.0",
    "keytar": "^7.9.0",
    "mammoth": "^1.12.0",
    "pdf-parse": "^1.1.1",
    "playwright": "^1.49.0"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5"
  },
  "build": {
    "appId": "com.fmsg.agents",
    "productName": "FMSG Agents",
    "directories": {
      "output": "dist/electron"
    },
    "win": {
      "target": "nsis",
      "icon": "installer/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": false,
      "license": "legal/LICENSE.txt",
      "include": "installer/installer.nsh",
      "installerHeader": "installer/installerHeader.bmp",
      "installerSidebar": "installer/installerSidebar.bmp",
      "uninstallerSidebar": "installer/installerSidebar.bmp",
      "installerIcon": "installer/icon.ico",
      "uninstallerIcon": "installer/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FMSG Agents",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "files": [
      "dist/**/*",
      "!dist/electron/**",
      "renderer/index.html",
      "renderer/design-system.css",
      "renderer/bundle.js",
      "legal/**/*",
      "!logs/**",
      "!.dev-diag-flag.json",
      "!scripts/**",
      "!tests/**"
    ]
  }
}
